    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@proofline/config": "workspace:*",
    "wrangler": "^4.137.0"
  }
