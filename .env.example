# Proofline API. Copy to .env (Node) or set as Worker secrets (wrangler secret put …).

# Required in production (≥ 32 chars each). Local dev falls back to insecure dev values.
TOKEN_SIGNING_SECRET=
IP_SALT_SECRET=
# Optional: comma-separated previous signing secrets, still accepted during rotation.
TOKEN_SIGNING_SECRET_PREVIOUS=

# Decisions. Without a key the API uses the deterministic MockProvider.
TYPESAFE_API_KEY=
# jev | mock | rules
DECISION_PROVIDER=
# jev-latest by default; pin a version (e.g. jev-1.13.0) once thresholds are tuned.
JEV_MODEL=

# Postgres. Unset = in-process PGlite (PGLITE_DIR to persist, otherwise in-memory).
DATABASE_URL=
PGLITE_DIR=

# Web Bot Auth allowlist: JSON array of {"name": "...", "directory": "https://..."}
TRUSTED_AGENTS=
# Known-bad IPs, comma-separated CIDRs.
BAD_IP_CIDRS=
# Node only: trust X-Forwarded-For (set when running behind your own proxy).
TRUST_PROXY=

# Demo site: point at an existing API instead of starting one in-process.
PROOFLINE_API_URL=
PROOFLINE_SECRET_KEY=
PROOFLINE_PUBLISHABLE_KEY=

# One-time codes (email_otp rung). Without RESEND_API_KEY codes are printed to the console (dev only).
RESEND_API_KEY=
EMAIL_FROM=
